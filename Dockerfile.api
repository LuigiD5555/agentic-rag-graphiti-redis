# ============================================
# RAG API Proxy - Minimal (Alpine, no heavy deps)
# ============================================
FROM python:3.12-alpine AS base

WORKDIR /app

# Minimal build dependencies for lightweight packages
RUN apk add --no-cache \
    gcc \
    musl-dev \
    libffi-dev

# Copy minimal requirements and install dependencies
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# ============================================
# Runtime stage (minimal proxy)
# ============================================
FROM base AS runtime

# Copy only the proxy app (no full src/ tree needed)
COPY src/api/app_proxy.py ./src/api/app_proxy.py
COPY src/api/__init__.py ./src/api/__init__.py

# Port is configurable via API_PORT environment variable (default: 8000)
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import os, requests; requests.get(f'http://localhost:{os.getenv(\"API_PORT\", \"8000\")}/health')" || exit 1

# Run proxy
CMD sh -c "uvicorn src.api.app_proxy:app --host 0.0.0.0 --port ${API_PORT:-8000}"

# ============================================
# Development stage (with hot-reload)
# ============================================
FROM runtime AS development

# Install development tools
RUN pip install --no-cache-dir pytest pytest-asyncio httpx ipdb

# Run with auto-reload for local development
CMD sh -c "uvicorn src.api.app_proxy:app --host 0.0.0.0 --port ${API_PORT:-8000} --reload"
