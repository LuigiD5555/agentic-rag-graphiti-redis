# ============================================
# RAG API Proxy - Minimal multi-stage build
# ============================================

# Stage 1: Builder (compile dependencies with build tools)
FROM python:3.12-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache \
    gcc \
    musl-dev \
    libffi-dev

# Install Python dependencies to /install prefix
COPY requirements-api.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements-api.txt

# ============================================
# Stage 2: Runtime (minimal, production-only)
# ============================================
FROM python:3.12-alpine AS runtime

WORKDIR /app

# Copy compiled dependencies from builder (no build tools!)
COPY --from=builder /install /usr/local

# Install ONLY runtime libraries needed (libffi for pydantic)
RUN apk add --no-cache libffi

# Copy only the proxy app (no full src/ tree needed)
COPY src/api/app_proxy.py ./src/api/app_proxy.py
COPY src/api/__init__.py ./src/api/__init__.py

# Port is configurable via API_PORT environment variable (default: 8000)
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import os, requests; requests.get(f'http://localhost:{os.getenv(\"API_PORT\", \"8000\")}/health')" || exit 1

# Run proxy (production mode, no reload)
CMD sh -c "uvicorn src.api.app_proxy:app --host 0.0.0.0 --port ${API_PORT:-8000}"
