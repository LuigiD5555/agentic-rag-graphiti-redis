# RAG Tools Configuration
# Add these to your main .env file

# Tool endpoints (socket-activated services)
TOOL_OFFICE_URL=http://127.0.0.1:9102
TOOL_ARCHIVE_URL=http://127.0.0.1:9101
TOOL_OCR_URL=http://127.0.0.1:9103
TOOL_GPU_URL=http://127.0.0.1:9104

# Tool feature flags
ENABLE_OFFICE_CONVERSION=true
ENABLE_ARCHIVE_EXTRACTION=true
ENABLE_OCR=true
ENABLE_GPU_ACCELERATION=false  # Set to true if you have GPU

# Tool timeouts (seconds)
TOOL_REQUEST_TIMEOUT=120
TOOL_OFFICE_TIMEOUT=60
TOOL_ARCHIVE_TIMEOUT=180
TOOL_OCR_TIMEOUT=120
TOOL_GPU_TIMEOUT=60

# OCR settings
OCR_DEFAULT_LANGUAGE=eng
OCR_DEFAULT_PSM=3  # Page segmentation mode

# Archive extraction safety
ARCHIVE_MAX_SIZE_MB=500
ARCHIVE_MAX_FILES=10000

# Office conversion preferences
OFFICE_DEFAULT_OUTPUT_FORMAT=pdf
