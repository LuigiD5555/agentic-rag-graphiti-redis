[Unit]
Description=Export journald logs to project folder on container stop (rag-graphiti-agentic)
After=default.target

[Service]
Type=simple

# Set this to your repo path (absolute).
Environment=REPO_DIR=/path/to/rag-agentic-graphiti

# Toggle export (admin can comment/uncomment).
Environment=ENABLE_LOG_EXPORT=1
#Environment=ENABLE_LOG_EXPORT=0

# Optional: debounce seconds / default window
Environment=DEBOUNCE_SECONDS=3
Environment=DEFAULT_SINCE=24 hours ago

ExecStart=/usr/bin/bash -lc 'cd "$REPO_DIR" && COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-rag-graphiti-agentic}" ENABLE_LOG_EXPORT="$ENABLE_LOG_EXPORT" DEBOUNCE_SECONDS="$DEBOUNCE_SECONDS" DEFAULT_SINCE="$DEFAULT_SINCE" ./scripts/podman_event_logexport.sh'
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
