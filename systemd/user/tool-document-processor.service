[Unit]
Description=RAG Tool Document Processor (OCR + Office conversion)
Documentation=https://github.com/LuigiD5555/agentic-rag-graphiti-redis
After=network-online.target
Wants=network-online.target
OnFailure=tool-alert@%n.service

[Service]
Type=simple

# 1) Clean up any previous container
ExecStartPre=/usr/bin/podman rm -f rag-tool-document-processor

# 2) Start the consolidated container (API on port 8000 inside, mapped to 19104 on host)
ExecStartPre=/usr/bin/podman run -d --name rag-tool-document-processor \
  --pull=never \
  -p 127.0.0.1:19104:8000 \
  -e HOME=/tmp \
  --security-opt=no-new-privileges \
  --cap-drop=all \
  --read-only \
  --tmpfs /tmp \
  -v %h/.cache/rag-tools/document-processor:/work:rw \
  -v /mnt:/mnt:ro \
  localhost/rag-tool-document-processor:latest

# 3) Wait for container to be ready (healthcheck)
ExecStartPre=/usr/bin/bash -c 'for i in {1..60}; do curl -fsS http://127.0.0.1:19104/healthz && exit 0; sleep 0.2; done; exit 1'

# 4) Proxy: socket (inherited FD) -> internal port
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:19104

# Stop the container when service stops
ExecStop=/usr/bin/podman stop -t 10 rag-tool-document-processor
ExecStopPost=/usr/bin/podman rm -f rag-tool-document-processor

Restart=on-failure
RestartSec=1
TimeoutStartSec=90
TimeoutStopSec=30

# Auto-shutdown after idle timeout (default 10 minutes)
# Service stops automatically, socket activation restarts it on next request
RuntimeMaxSec=600

[Install]
