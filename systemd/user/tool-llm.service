[Unit]
Description=RAG Tool LLM Server
Documentation=https://github.com/LuigiD5555/agentic-rag-graphiti-redis
Requires=tool-llm.socket
After=tool-llm.socket

[Service]
Type=notify
# Guard: only start tools when RAG API is initialized
ExecStartPre=/usr/bin/bash -c 'curl -fsS http://127.0.0.1:8000/health | grep -q "\"rag_initialized\": true"'
# Run via podman
ExecStart=/usr/bin/podman run \
    --rm \
    --name=tool-llm \
    --network=rag-network \
    -v llm-models:/models:Z \
    -v rag-work:/work:Z \
    --sdnotify=conmon \
    localhost/rag-tool-llm:latest

ExecStop=/usr/bin/podman stop -t 10 tool-llm

# Resource limits
MemoryMax=8G
CPUQuota=400%

# Restart policy
Restart=on-failure
RestartSec=10s

# Security
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=default.target
