[Unit]
Description=RAG Tool GPU (container + proxy)
Documentation=https://github.com/LuigiD5555/agentic-rag-graphiti-redis
After=network-online.target
Wants=network-online.target
OnFailure=tool-alert@%n.service

[Service]
Type=simple

# 1) Clean up any previous container
ExecStartPre=/usr/bin/podman rm -f rag-tool-gpu

# 2) Start the container with GPU access (API on port 8000 inside, mapped to 19104 on host)
# Note: --device=nvidia.com/gpu=all requires nvidia-container-toolkit with CDI support
ExecStartPre=/usr/bin/podman run -d --name rag-tool-gpu \
  --pull=never \
  -p 127.0.0.1:19104:8000 \
  --security-opt=label=disable \
  --device=nvidia.com/gpu=all \
  -v %h/.cache/rag-tools/gpu:/work:rw \
  -v /mnt:/mnt:ro \
  localhost/rag-tool-gpu:latest

# 3) Wait for container to be ready (healthcheck)
ExecStartPre=/usr/bin/bash -c 'for i in {1..60}; do curl -fsS http://127.0.0.1:19104/healthz && exit 0; sleep 0.2; done; exit 1'

# 4) Proxy: socket (inherited FD) -> internal port
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:19104

# Stop the container when service stops
ExecStop=/usr/bin/podman stop -t 10 rag-tool-gpu
ExecStopPost=/usr/bin/podman rm -f rag-tool-gpu

Restart=on-failure
RestartSec=1
TimeoutStartSec=90
TimeoutStopSec=30

# Auto-shutdown after idle timeout (default 10 minutes)
# Service stops automatically, socket activation restarts it on next request
RuntimeMaxSec=600

[Install]
