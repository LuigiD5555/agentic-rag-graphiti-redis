[Unit]
Description=RAG Tool WebSearch (container + proxy)
Documentation=https://github.com/LuigiD5555/agentic-rag-graphiti-redis
After=network-online.target
Wants=network-online.target
OnFailure=tool-alert@%n.service

[Service]
Type=simple

# 1) Clean up any previous container
ExecStartPre=/usr/bin/podman rm -f rag-tool-websearch

# 2) Start the container using wrapper script
ExecStartPre=%h/.local/bin/start-websearch-container.sh

# 3) Wait for container to be ready (healthcheck)
ExecStartPre=/usr/bin/bash -c 'for i in {1..60}; do curl -fsS http://127.0.0.1:19105/healthz && exit 0; sleep 0.2; done; exit 1'

# 4) Proxy: socket (inherited FD) -> internal port
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:19105

# Stop the container when service stops
ExecStop=/usr/bin/podman stop -t 10 rag-tool-websearch
ExecStopPost=/usr/bin/podman rm -f rag-tool-websearch

Restart=on-failure
RestartSec=1
TimeoutStartSec=90
TimeoutStopSec=30

# Auto-shutdown after idle timeout (default 10 minutes)
# Service stops automatically, socket activation restarts it on next request
RuntimeMaxSec=600

[Install]
